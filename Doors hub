local function addToggle(label, key, onChange)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -6, 0, 30)
    b.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.Gotham
    b.TextSize = 14
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Parent = content
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    local function refresh()
        b.Text = label .. ": " .. (State[key] and "ON" or "OFF")
        b.BackgroundColor3 = State[key] and Color3.fromRGB(40, 140, 80) or Color3.fromRGB(45, 45, 52)
    end
    refresh()

    b.MouseButton1Click:Connect(function()
        State[key] = not State[key]
        refresh()
        if onChange then onChange(State[key]) end
    end)
end

