-- ESP de portas
local espFolder = Instance.new("Folder")
espFolder.Name = "DoorsHubESP"
espFolder.Parent = parentGui

local function refreshESP()
    espFolder:ClearAllChildren()
    if not State.DoorESP then return end
    local rooms = currentRooms()
    if not rooms then return end
    for _, room in ipairs(rooms:GetChildren()) do
        local door = room:FindFirstChild("Door")
        local part = door and door:FindFirstChild("Door")
        if part then
            local h = Instance.new("Highlight")
            h.Adornee = door
            h.FillColor = Color3.fromRGB(80, 255, 120)
            h.FillTransparency = 0.5
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = espFolder
        end
    end
end

-- ESP de objetos (itens, ouro, esconderijos, entidades, livros)
local objFolder = Instance.new("Folder")
objFolder.Name = "DoorsHubObjESP"
objFolder.Parent = parentGui

local tracked = {}

local COLORS = {
    Items = Color3.fromRGB(70, 160, 255),
    Gold = Color3.fromRGB(255, 215, 60),
    Hiding = Color3.fromRGB(80, 255, 120),
    Entities = Color3.fromRGB(255, 70, 70),
    Books = Color3.fromRGB(190, 110, 255),
}

-- nomes de entidades (podem mudar com atualizações do jogo)
local ENTITY_NAMES = {
    RushMoving = "Rush", AmbushMoving = "Ambush", BackdoorRush = "Blitz",
    Eyes = "Eyes", A60 = "A-60", A120 = "A-120", SeekMoving = "Seek",
    FigureRig = "Figure", FigureRagdoll = "Figure", Halt = "Halt",
    Screech = "Screech", JeffTheKiller = "Jeff",
}

local function ownerModel(prompt, room)
    local p = prompt.Parent
    if not p then return nil end
    local m = p:IsA("Model") and p or p:FindFirstAncestorWhichIsA("Model")
    if m == room or m == workspace then return nil end
    return m
end

local function track(inst, label, color, seen)
    seen[inst] = true
    if tracked[inst] then return end

    local hl = Instance.new("Highlight")
    hl.Adornee = inst
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = 0.6
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = objFolder

    local anchor = inst
    if inst:IsA("Model") then
        anchor = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
    end

    local bb, txt
    if anchor then
        bb = Instance.new("BillboardGui")
        bb.Adornee = anchor
        bb.Size = UDim2.fromOffset(140, 20)
        bb.StudsOffset = Vector3.new(0, 2, 0)
        bb.AlwaysOnTop = true
        bb.Parent = objFolder

        txt = Instance.new("TextLabel")
        txt.Size = UDim2.fromScale(1, 1)
        txt.BackgroundTransparency = 1
        txt.TextColor3 = color
        txt.TextStrokeTransparency = 0.3
        txt.Font = Enum.Font.GothamBold
        txt.TextSize = 13
        txt.Text = label
        txt.Parent = bb
    end

    tracked[inst] = { hl = hl, bb = bb, txt = txt, label = label }
end

local function scanESP()
    local seen = {}
    local root = getRoot()
    local rooms = currentRooms()
    local n = latestRoom()

    -- entidades soltas no workspace
    if State.ESPEntities then
        for _, c in ipairs(workspace:GetChildren()) do
            local nm = ENTITY_NAMES[c.Name]
            if nm and c:IsA("Model") then
                track(c, nm, COLORS.Entities, seen)
            end
        end
    end

    if rooms then
        for i = math.max(1, n - 1), n + 1 do
            local room = rooms:FindFirstChild(tostring(i))
            if room then
                for _, d in ipairs(room:GetDescendants()) do
                    if State.ESPEntities and d:IsA("Model") and ENTITY_NAMES[d.Name] then
                        track(d, ENTITY_NAMES[d.Name], COLORS.Entities, seen)
                    elseif d:IsA("ProximityPrompt") then
                        local m = ownerModel(d, room)
                        if m then
                            if m.Name == "GoldPile" or d.Name == "LootPrompt" then
                                if State.ESPGold then
                                    local v = m:GetAttribute("GoldValue")
                                    track(m, "Ouro" .. (v and (" (" .. v .. ")") or ""), COLORS.Gold, seen)
                                end
                            elseif d.Name == "HidePrompt" then
                                if State.ESPHiding then
                                    track(m, "Esconderijo", COLORS.Hiding, seen)
                                end
                            elseif m.Name == "LiveHintBook" then
                                if State.ESPBooks then
                                    track(m, "Livro", COLORS.Books, seen)
                                end
                            elseif d.Name == "ModulePrompt" then
                                if State.ESPItems then
                                    local label = (m.Name == "KeyObtain") and "Chave" or m.Name
                                    track(m, label, COLORS.Items, seen)
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- remove o que sumiu / foi desligado e atualiza distância
    for inst, t in pairs(tracked) do
        if not seen[inst] or not inst.Parent then
            if t.hl then t.hl:Destroy() end
            if t.bb then t.bb:Destroy() end
            tracked[inst] = nil
        elseif t.txt and root then
            local pos = getPos(inst)
            if pos then
                t.txt.Text = t.label .. " [" .. math.floor((pos - root.Position).Magnitude) .. "]"
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.8) do
        if State.ESPItems or State.ESPGold or State.ESPHiding
            or State.ESPEntities or State.ESPBooks or next(tracked) then
            pcall(scanESP)
        end
    end
end)

-- Loops principais
task.spawn(function()
    while task.wait(1) do
        if State.AutoLoot then pcall(collectGold) end
    end
end)

task.spawn(function()
    while task.wait(1) do
        if State.AutoKey then pcall(collectKey) end
    end
end)

task.spawn(function()
    local last = -1
    while task.wait(1.5) do
        if State.AutoDoor then
            local n = latestRoom()
            if n ~= last then
                last = n
                pcall(goToDoor)
            end
        end
        if State.InstantPrompt then pcall(applyInstant) end
        if State.DoorESP then pcall(refreshESP) end
    end
end)

