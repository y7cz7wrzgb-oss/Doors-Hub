-- Funções
--------------------------------------------------------------------
-- Auto moedas (GoldPile nas salas + drops no chão)
local function collectGold()
    local rooms = currentRooms()
    local root = getRoot()
    if not rooms or not root then return end

    local back = root.CFrame
    local n = latestRoom()
    for i = math.max(1, n - 1), n + 1 do
        local room = rooms:FindFirstChild(tostring(i))
        if room then
            for _, d in ipairs(room:GetDescendants()) do
                if not State.AutoLoot then return end
                if d:IsA("ProximityPrompt") and d.Enabled
                    and (d.Name == "LootPrompt" or (d.Parent and d.Parent.Name == "GoldPile")) then
                    local pos = getPos(d)
                    if pos then
                        teleportTo(pos)
                        task.wait(0.15)
                        fire(d)
                        task.wait(0.1)
                    end
                end
            end
        end
    end

    local drops = workspace:FindFirstChild("Drops")
    if drops then
        for _, item in ipairs(drops:GetChildren()) do
            if not State.AutoLoot then return end
            local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                teleportTo(getPos(item))
                task.wait(0.15)
                fire(prompt)
            end
        end
    end

    if root.Parent then root.CFrame = back end
end

-- Auto chave
local function collectKey()
    local rooms = currentRooms()
    if not rooms then return end
    local room = rooms:FindFirstChild(tostring(latestRoom()))
    if not room then return end
    for _, d in ipairs(room:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled
            and d.Parent and d.Parent.Name == "KeyObtain" then
            teleportTo(getPos(d))
            task.wait(0.2)
            fire(d)
            task.wait(0.2)
        end
    end
end

-- Auto porta (vai até a porta da sala atual)
local function goToDoor()
    local rooms = currentRooms()
    if not rooms then return end
    local room = rooms:FindFirstChild(tostring(latestRoom()))
    local door = room and room:FindFirstChild("Door")
    local part = door and (door:FindFirstChild("Door") or door.PrimaryPart)
    if part then
        local r = getRoot()
        if r then
            r.CFrame = part.CFrame * CFrame.new(0, 0, -4)
        end
    end
end

-- Interação instantânea
workspace.DescendantAdded:Connect(function(d)
    if State.InstantPrompt and d:IsA("ProximityPrompt") then
        d.HoldDuration = 0
    end
end)

local function applyInstant()
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            d.HoldDuration = 0
            d.MaxActivationDistance = math.max(d.MaxActivationDistance, 12)
        end
    end
end

-- Fullbright
local origLight = {
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    FogEnd = Lighting.FogEnd,
    GlobalShadows = Lighting.GlobalShadows,
    Ambient = Lighting.Ambient,
}
RunService.RenderStepped:Connect(function()
    if State.Fullbright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 1e6
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(180, 180, 180)
