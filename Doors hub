local function addSpeedBox()
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -6, 0, 30)
    box.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
    box.PlaceholderText = "Velocidade (16 = normal)"
    box.Text = tostring(State.Speed)
    box.TextColor3 = Color3.new(1, 1, 1)
    box.PlaceholderColor3 = Color3.fromRGB(150, 150, 150)
    box.Font = Enum.Font.Gotham
    box.TextSize = 14
    box.BorderSizePixel = 0
    box.ClearTextOnFocus = false
    box.Parent = content
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
    box.FocusLost:Connect(function()
        local v = tonumber(box.Text)
        if v then
            State.Speed = math.clamp(v, 8, 500)
            local h = getHum()
            if h and State.Speed == 16 then h.WalkSpeed = 16 end
        end
    end)
end

