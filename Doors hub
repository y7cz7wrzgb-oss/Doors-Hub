--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function getRoot()
    local c = lp.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = lp.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function latestRoom()
    local gd = RS:FindFirstChild("GameData")
    local v = gd and gd:FindFirstChild("LatestRoom")
    return v and v.Value or 0
end

local function getPos(inst)
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    local p = inst:FindFirstAncestorWhichIsA("BasePart")
    if p then return p.Position end
    local m = inst:FindFirstAncestorWhichIsA("Model")
    return m and m:GetPivot().Position
end

local function teleportTo(pos)
    local r = getRoot()
    if r and pos then
        r.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    end
end

local function fire(prompt)
    if fireproximityprompt then
        fireproximityprompt(prompt)
    end
end

local function currentRooms()
    return workspace:FindFirstChild("CurrentRooms")
end

